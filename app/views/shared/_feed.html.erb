<% if @feed_items.any? %>
  <ol class="microposts">
    <% if @pin_microposts.any? %>
      <p>Pinning</p>
      <%= render @pin_microposts %>
      <p>Not Pinned</p>
    <% end %>
    <%= render @feed_items %>
  </ol>
  <%= will_paginate @feed_items,
                    params: { controller: :static_pages, action: :home } %>
<% end %>
