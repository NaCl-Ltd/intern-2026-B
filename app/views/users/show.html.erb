<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>
      </h1>
      <p class="user-introduction"><%= @user.introduction %></p>
    </section>
    <section class="stats">
      <%= render 'shared/stats' %>
    </section>
  </aside>
  <div class="col-md-8">
    <%= render 'follow_form' if logged_in? %>
    <% if @user.microposts.any? %>
      <h3>Microposts (<%= @user.microposts.count %>)</h3>
      <ol class="microposts">
        <% if @pin_microposts.count > 0 %>
          <p>Pinning</p>
          <%= render @pin_microposts %>
          <p>Not Pinned</p>
          <%= render @unpin_microposts %>
        <% else %>
          <%= render @unpin_microposts %>
        <% end %>
      </ol>
      <%= will_paginate @unpin_microposts %>
    <% end %>
  </div>
</div>
