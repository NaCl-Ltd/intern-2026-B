<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>
      </h1>
      <p class="user-introduction"><%= @user.introduction %></p>
    </section>
    <section class="stats">
      <%= render 'shared/stats' %>
    </section>
    <section>      
      <%= render 'shared/links' %>
    </section>
  </aside>
  <div class="col-md-8">
    <%= render 'follow_form' if logged_in? %>
    <% if @user.microposts.any? %>
      <h3><%= @title %></h3>
      <ol class="microposts">
        <% if @microposts_a.any? %>
          <p><%= @microposts_title_a %></p>
          <%= render @microposts_a %>
          <p><%= @microposts_title_b %></p>
          <%= render @microposts_b %>
        <% else %>
          <%= render @microposts_b %>
        <% end %>
      </ol>
      <%= will_paginate @microposts_b %>
    <% end %>
  </div>
</div>
