<% provide(:title, @user.name) %>
<div class="row">
  <aside class="col-md-4">
    <section class="user_info">
      <h1>
        <%= gravatar_for @user %>
        <%= @user.name %>
      </h1>
      <p class="user-introduction"><%= @user.introduction %></p>
    </section>
    <section class="stats">
      <%= render 'shared/stats' %>
    </section>    
    <section>
      <%= render 'shared/links' %>
    </section>
  </aside>
  <div class="col-md-8">
    <%= render 'follow_form' if logged_in? %>
    <% if @user.microposts.any? %>
      <!-- #add -->
      <h3>Likes (<%#= @like_posts.count %>)</h3>      
      <ol class="microposts">
        <%#= render @like_posts %>
      </ol>
      <%#= will_paginate @like_posts %>      
    <% end %>
  </div>
</div>
